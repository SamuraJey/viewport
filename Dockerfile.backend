# syntax=docker/dockerfile:1

ARG PYTHON_VERSION=3.14
ARG UV_VERSION=0.11.21
ARG APP_UID=1001
ARG APP_GID=1001

FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv

# Debian's general-purpose ffmpeg pulls in Mesa/LLVM, device and GUI libraries.
# Keep Debian's patched source, all built-in input codecs and file containers,
# but link only the external codecs needed for uploads (H.264 output / AV1 input).
FROM python:${PYTHON_VERSION}-slim AS ffmpeg-build
ARG FFMPEG_BUILD_JOBS=4
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=apt-ffmpeg-source,target=/var/lib/apt,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean && \
    sed 's/^Types: deb$/Types: deb-src/' /etc/apt/sources.list.d/debian.sources \
        > /etc/apt/sources.list.d/debian-src.sources && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential dpkg-dev pkg-config nasm libx264-dev libdav1d-dev zlib1g-dev libbz2-dev liblzma-dev
WORKDIR /tmp/ffmpeg
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=apt-ffmpeg-source,target=/var/lib/apt,sharing=locked \
    apt-get update && \
    apt-get source --only-source ffmpeg && \
    cd "$(find . -maxdepth 1 -type d -name 'ffmpeg-*' -print -quit)" && \
    ./configure --prefix=/opt/ffmpeg \
        --disable-autodetect --disable-debug --disable-doc --disable-ffplay \
        --disable-avdevice --disable-network --disable-static --enable-shared \
        --enable-gpl --enable-libx264 --enable-libdav1d \
        --enable-zlib --enable-bzlib --enable-lzma && \
    make -j"${FFMPEG_BUILD_JOBS}" && \
    make install && \
    rm -rf /opt/ffmpeg/include /opt/ffmpeg/lib/pkgconfig /opt/ffmpeg/share/ffmpeg && \
    mkdir -p /opt/ffmpeg/share/licenses && \
    cp COPYING* /opt/ffmpeg/share/licenses/

FROM python:${PYTHON_VERSION}-slim AS build
COPY --from=uv /uv /uvx /bin/

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean && \
    apt-get update && \
    apt-get install -y --no-install-recommends build-essential libvips-dev pkg-config

WORKDIR /app

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

COPY uv.lock pyproject.toml README.md ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-install-project --no-dev
RUN .venv/bin/python -c "import pyvips; assert pyvips.API_mode; assert pyvips.type_find('VipsOperation', 'heifsave_buffer')"

# Copy source code separately - light layer, invalidated on code changes
COPY src/ src/

FROM python:${PYTHON_VERSION}-slim AS runtime-base

ARG APP_UID
ARG APP_GID

RUN groupadd --system --gid "${APP_GID}" appgroup && \
    useradd --system --uid "${APP_UID}" --gid appgroup --home-dir /app --shell /bin/false appuser
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        libimage-exiftool-perl libheif-plugin-aomenc libvips42t64 libx264-164 libdav1d7

COPY --from=ffmpeg-build /opt/ffmpeg /opt/ffmpeg
RUN echo /opt/ffmpeg/lib > /etc/ld.so.conf.d/ffmpeg.conf && ldconfig

WORKDIR /app
ENV PATH="/app/.venv/bin:/opt/ffmpeg/bin:$PATH" \
    PYTHONPATH="/app/src" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONFAULTHANDLER=1

COPY --from=build --chown=appuser:appgroup /app/.venv /app/.venv
RUN --mount=type=bind,source=ci/check_backend_media.py,target=/tmp/check_backend_media.py \
    python /tmp/check_backend_media.py

COPY --from=build --chown=appuser:appgroup /app/src /app/src

# Extend the already-built production environment with dev dependencies only.
# Reuse the build toolchain so native Python packages keep their production ABI.
FROM build AS test-deps
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-install-project

FROM runtime-base AS test
COPY --from=test-deps /app/.venv /app/.venv
COPY pyproject.toml uv.lock README.md alembic.ini ./
COPY tests/ tests/
RUN exiftool -ver && \
    python -c "import pytest, pyvips; assert pyvips.API_mode; image = pyvips.Image.black(2, 3).rot('d90'); assert (image.width, image.height) == (3, 2); assert image.pngsave_buffer(); assert image.heifsave_buffer(compression='av1', Q=70)"
# CI runs this target on an isolated runner with its Docker socket for Testcontainers.
HEALTHCHECK NONE
CMD ["pytest", "tests/"]

# Keep the default/final target production-only; never inherit from test.
FROM runtime-base AS runtime
USER appuser
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/', timeout=3)"]
CMD ["python", "-m", "uvicorn", "src.viewport.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-proxy-headers"]
